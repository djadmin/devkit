#!/usr/bin/env bash
# devkit — local app registry, hostname proxy, process manager, dashboard.
# Source of truth: $DEVKIT_HOME/apps.json
# Generates:       $DEVKIT_HOME/Caddyfile, $DEVKIT_HOME/dashboard.html
#
# Data lives in $DEVKIT_HOME (default: ~/.devkit — a dotfile dir like .ssh/.aws,
# kept separate from wherever the binary is installed: Homebrew, ~/.local/bin, or a
# source checkout). Override DEVKIT_HOME to use XDG or any custom path.

set -euo pipefail

DEVKIT_VERSION="0.3.0"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

# Did the user pin DEVKIT_HOME themselves? If so we never auto-migrate or second-guess
# it. Capture this BEFORE applying the default so the two cases stay distinguishable.
if [[ -n "${DEVKIT_HOME:-}" ]]; then DEVKIT_HOME_EXPLICIT=1; else DEVKIT_HOME_EXPLICIT=0; fi
DEVKIT_HOME="${DEVKIT_HOME:-$HOME/.devkit}"

APPS_JSON="$DEVKIT_HOME/apps.json"
CADDYFILE="$DEVKIT_HOME/Caddyfile"
DASHBOARD="$DEVKIT_HOME/dashboard.html"
PIDS_DIR="$DEVKIT_HOME/pids"
LOGS_DIR="$DEVKIT_HOME/logs"
LOCK_DIR="$DEVKIT_HOME/.registry.lock"
# Stamp recording the registry fingerprint the generated config was last built from.
# Lets every command cheaply detect an out-of-band apps.json edit and self-heal.
STAMP_FILE="$DEVKIT_HOME/.caddy.fingerprint"
BREW_CADDYFILE="${DEVKIT_BREW_CADDYFILE:-/opt/homebrew/etc/Caddyfile}"

die() { echo "devkit: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

need jq
need lsof
need pgrep

# Pick a content hasher once. shasum ships with macOS; the others are fallbacks so
# the staleness check still works on minimal/Linux environments and in CI.
if command -v shasum >/dev/null 2>&1; then
  _hash() { shasum | awk '{print $1}'; }
elif command -v sha1sum >/dev/null 2>&1; then
  _hash() { sha1sum | awk '{print $1}'; }
else
  _hash() { cksum | awk '{print $1"-"$2}'; }
fi

ensure_registry_dir() {
  mkdir -p "$DEVKIT_HOME" "$PIDS_DIR" "$LOGS_DIR" 2>/dev/null || true
}

# One-time move of an old-style registry into the new default location (~/.devkit).
#
# Earlier versions defaulted DEVKIT_HOME to the install/checkout directory, so data
# landed in ~/devkit (or wherever the repo was cloned). That pollutes $HOME with a
# visible folder and breaks the moment the binary moves (Homebrew, ~/.local/bin). We
# now keep data in ~/.devkit and migrate the old registry across the first time we run.
#
# Self-guarding and idempotent: returns immediately once ~/.devkit/apps.json exists, or
# if the user pinned DEVKIT_HOME themselves. Caddyfile/dashboard are regenerated rather
# than moved, so we only relocate the source of truth plus live runtime state.
migrate_home_location() {
  [[ "$DEVKIT_HOME_EXPLICIT" == "0" ]] || return 0
  [[ -f "$APPS_JSON" ]] && return 0

  local legacy="" cand
  for cand in "$HOME/devkit" "$REPO_HOME"; do
    [[ "$cand" == "$DEVKIT_HOME" ]] && continue
    if [[ -f "$cand/apps.json" ]]; then legacy="$cand"; break; fi
  done
  [[ -n "$legacy" ]] || return 0

  mkdir -p "$DEVKIT_HOME" "$PIDS_DIR" "$LOGS_DIR" 2>/dev/null || return 0
  echo "devkit: migrating registry from $legacy → $DEVKIT_HOME (one-time)" >&2

  mv "$legacy/apps.json" "$APPS_JSON" 2>/dev/null || cp "$legacy/apps.json" "$APPS_JSON" 2>/dev/null || return 0
  if [[ -d "$legacy/pids" ]]; then mv "$legacy/pids/"*.pid "$PIDS_DIR/" 2>/dev/null || true; fi
  if [[ -d "$legacy/logs" ]]; then mv "$legacy/logs/"*.log "$LOGS_DIR/" 2>/dev/null || true; fi

  # If Caddy was pointed at the old generated config via the brew symlink, repoint it
  # so reloads keep working. The new Caddyfile is regenerated on the next render.
  local linked; linked=$(readlink "$BREW_CADDYFILE" 2>/dev/null || true)
  if [[ "$linked" == "$legacy/Caddyfile" ]]; then
    ln -sfn "$CADDYFILE" "$BREW_CADDYFILE" 2>/dev/null || true
  fi
  # Drop now-stale generated artifacts at the old location (registry already moved).
  rm -f "$legacy/Caddyfile" "$legacy/dashboard.html" "$legacy/.caddy.fingerprint" 2>/dev/null || true

  echo "devkit: migration complete — the binary/checkout at $legacy is left untouched." >&2
}

ensure_registry() {
  ensure_registry_dir
  migrate_home_location
  if [[ ! -f "$APPS_JSON" ]]; then
    echo '{"version":1,"proxyPort":80,"tld":"localhost","dashboardHost":"dash","apps":[]}' > "$APPS_JSON" 2>/dev/null || true
  fi
  # Catch a broken hand-edit / partial sync up front with a clear message, instead of
  # letting every downstream `jq` spew cryptic parse errors (or worse, render an empty
  # Caddyfile that silently drops every route).
  if [[ -s "$APPS_JSON" ]] && ! jq empty "$APPS_JSON" >/dev/null 2>&1; then
    die "registry is not valid JSON: $APPS_JSON
  Fix the file or restore a backup. devkit won't touch routing until it parses."
  fi
}

# Portable advisory lock around registry read-modify-write. macOS has no flock(1), so
# we use mkdir (atomic) as the lock primitive, with stale-lock reclaim if the holder
# process is dead. Without this, the menu bar app's polling plus a concurrent CLI write
# can interleave two read-modify-write cycles and silently drop an app from apps.json.
acquire_lock() {
  # Reentrant within a single process: once held, nested callers (e.g. the legacy
  # migration invoked from inside a register) are no-ops. The lock is process-scoped
  # and released by the EXIT trap, which is exactly the lifetime of one CLI invocation.
  [[ "${LOCK_HELD:-0}" == "1" ]] && return 0
  ensure_registry_dir
  local timeout="${1:-100}" i=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [[ -f "$LOCK_DIR/pid" ]]; then
      local lpid; lpid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
      if [[ -n "$lpid" ]] && ! kill -0 "$lpid" 2>/dev/null; then
        rm -rf "$LOCK_DIR" 2>/dev/null || true
        continue
      fi
    fi
    if (( i++ >= timeout )); then
      die "could not acquire registry lock (held by pid $(cat "$LOCK_DIR/pid" 2>/dev/null || echo '?')) — try again in a moment"
    fi
    sleep 0.1
  done
  echo "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
  LOCK_HELD=1
  # Release on any exit so a crash/die never leaves a stuck lock for this process.
  trap 'release_lock' EXIT INT TERM
}

release_lock() {
  rm -rf "$LOCK_DIR" 2>/dev/null || true
  LOCK_HELD=0
}

migrate_legacy_registry() {
  ensure_registry
  jq -e '.apps[]? | select(.managedBy == "pm2")' "$APPS_JSON" >/dev/null 2>&1 || return 0

  # This is a read-modify-write of apps.json. Take the lock so a concurrent writer
  # (another CLI run, or the menu bar app) can't lose an update. acquire_lock is
  # reentrant, so this is a no-op when a mutating command already holds it.
  acquire_lock
  local tmp; tmp=$(mktemp)
  jq '.apps |= map(if .managedBy == "pm2" then .managedBy = "devkit" else . end)' "$APPS_JSON" > "$tmp"
  mv "$tmp" "$APPS_JSON"
}

cfg() { jq -r "$1" "$APPS_JSON"; }
proxy_port()    { cfg '.proxyPort // 80'; }
tld()           { cfg '.tld // "localhost"'; }
dash_host()     { cfg '.dashboardHost // "dash"'; }

url_for() {
  local host="$1" pp; pp=$(proxy_port)
  if [[ "$pp" == "80" ]]; then echo "http://$host"; else echo "http://$host:$pp"; fi
}

# ---------- helpers ----------

detect_repo() {
  local path="$1"
  git -C "$path" remote get-url origin 2>/dev/null || true
}

detect_claude_md() {
  local path="$1"
  [[ -f "$path/CLAUDE.md" ]] && echo "$path/CLAUDE.md"
}

# A name becomes a Caddy site address (http://<name>.<tld>) and pid/log filenames.
# Anything outside a DNS label — spaces, slashes, uppercase, dots — produces an invalid
# Caddyfile that fails to load, which would take down routing for EVERY app on the next
# reload. Reject it up front so one bad register can't break the whole proxy.
valid_name() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; }
assert_valid_name() {
  valid_name "$1" || die "invalid app name '$1' — use lowercase letters, digits and hyphens, e.g. my-api"
}

# Ports must be real TCP ports. 0 is the sentinel for external apps registered without one.
assert_valid_port() {
  local p="$1"
  [[ -z "$p" || "$p" == "0" ]] && return 0
  [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 )) || die "--port must be between 1 and 65535, got: $p"
}

assert_unique() {
  local name="$1" port="$2" hostname="$3"
  ensure_registry
  # Re-registering the SAME name is an allowed upsert, but the port/hostname must never
  # collide with a DIFFERENT app (which would create two Caddy routes for one port).
  # Skip the port check for the 0/empty sentinel (external apps registered without one).
  if [[ -n "$port" && "$port" != "0" ]] && \
     jq -e --arg n "$name" --argjson p "$port" '.apps[] | select(.name != $n and .port==$p)' "$APPS_JSON" >/dev/null; then
    die "port $port already taken by another app"
  fi
  if jq -e --arg n "$name" --arg h "$hostname" '.apps[] | select(.name != $n and .hostname==$h)' "$APPS_JSON" >/dev/null; then
    die "hostname $hostname already taken"
  fi
}

pid_file() { echo "$PIDS_DIR/$1.pid"; }
log_file() { echo "$LOGS_DIR/$1.log"; }
app_port() { jq -r --arg n "$1" '.apps[] | select(.name==$n) | .port // empty' "$APPS_JSON"; }

canonical_path() {
  local target="$1"
  [[ -n "$target" ]] || return 1
  if [[ -d "$target" ]]; then
    (cd "$target" 2>/dev/null && pwd -P) || return 1
  else
    local dir base
    dir=$(dirname "$target")
    base=$(basename "$target")
    [[ -d "$dir" ]] || return 1
    printf '%s/%s\n' "$(cd "$dir" 2>/dev/null && pwd -P)" "$base"
  fi
}

app_path() {
  local path=""
  path=$(jq -r --arg n "$1" '.apps[] | select(.name==$n) | .path // empty' "$APPS_JSON")
  canonical_path "$path" 2>/dev/null || printf '%s\n' "$path"
}

listener_pids_on_port() {
  local port="$1"
  lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk '!seen[$0]++'
}

port_is_listening() {
  local port="$1"
  [[ -n "$(listener_pids_on_port "$port")" ]]
}

wait_for_pid_exit() {
  local pid="$1" attempts="${2:-50}"
  local i=0
  while kill -0 "$pid" 2>/dev/null && (( i < attempts )); do
    sleep 0.1
    (( i++ ))
  done
  ! kill -0 "$pid" 2>/dev/null
}

wait_for_port_state() {
  local port="$1" desired="$2" attempts="${3:-50}"
  local i=0
  while (( i < attempts )); do
    if port_is_listening "$port"; then
      [[ "$desired" == "listening" ]] && return 0
    else
      [[ "$desired" == "free" ]] && return 0
    fi
    sleep 0.1
    (( i++ ))
  done

  if port_is_listening "$port"; then
    [[ "$desired" == "listening" ]]
  else
    [[ "$desired" == "free" ]]
  fi
}

path_belongs_to_app() {
  local candidate="$1" root="$2"
  [[ -n "$candidate" && -n "$root" ]] || return 1
  candidate=$(canonical_path "$candidate" 2>/dev/null || printf '%s\n' "$candidate")
  root=$(canonical_path "$root" 2>/dev/null || printf '%s\n' "$root")
  [[ "$candidate" == "$root" || "$candidate" == "$root/"* ]]
}

pid_cwd() {
  local pid="$1"
  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n1
}

pid_has_open_path() {
  local pid="$1" target="$2"
  [[ -n "$target" ]] || return 1
  target=$(canonical_path "$target" 2>/dev/null || printf '%s\n' "$target")
  lsof -p "$pid" 2>/dev/null | awk -v target="$target" '$NF == target { found=1 } END { exit(found ? 0 : 1) }'
}

pid_matches_app_path() {
  local pid="$1" path="$2"
  local cwd=""
  cwd=$(pid_cwd "$pid")
  path_belongs_to_app "$cwd" "$path"
}

descendant_pids() {
  local pid="$1"
  printf '%s\n' "$pid"
  local children=""
  children=$(pgrep -P "$pid" 2>/dev/null || true)
  local child
  for child in $children; do
    descendant_pids "$child"
  done
}

tree_contains_pid() {
  local root="$1" target="$2"
  local pid
  for pid in $(descendant_pids "$root"); do
    [[ "$pid" == "$target" ]] && return 0
  done
  return 1
}

tree_contains_listener_on_port() {
  local root="$1" port="$2"
  local listener
  for listener in $(listener_pids_on_port "$port"); do
    tree_contains_pid "$root" "$listener" && return 0
  done
  return 1
}

pid_matches_app_identity() {
  local pid="$1" path="$2" logfile="$3"
  pid_matches_app_path "$pid" "$path" && return 0
  pid_has_open_path "$pid" "$logfile"
}

listener_pids_for_app() {
  local port="$1" path="$2" logfile="$3"
  local listener
  for listener in $(listener_pids_on_port "$port"); do
    if pid_matches_app_identity "$listener" "$path" "$logfile"; then
      printf '%s\n' "$listener"
    fi
  done | awk '!seen[$0]++'
}

pid_matches_app() {
  local pid="$1" port="$2" path="$3" logfile="$4"
  pid_matches_app_identity "$pid" "$path" "$logfile" && return 0
  [[ -n "$port" ]] && tree_contains_listener_on_port "$pid" "$port"
}

is_running() {
  local name="$1"
  local port path logfile
  port=$(app_port "$name")
  path=$(app_path "$name")
  logfile=$(log_file "$name")

  local pf; pf=$(pid_file "$name")
  if [[ -f "$pf" ]]; then
    local pid; pid=$(cat "$pf")
    if kill -0 "$pid" 2>/dev/null && pid_matches_app "$pid" "$port" "$path" "$logfile"; then
      return 0
    fi
  fi

  [[ -n "$port" && -n "$path" && -n "$(listener_pids_for_app "$port" "$path" "$logfile")" ]]
}

# ---------- commands ----------

cmd_register() {
  local name="" path="" port="" cmd="" claude="" repo="" desc="" managed="devkit"

  # Accept positional name as first arg: devkit register my-api --port 3000 --cmd "..."
  if [[ $# -gt 0 && "$1" != --* ]]; then
    name="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)       name="$2";    shift 2 ;;
      --path)       path="$2";    shift 2 ;;
      --port)       port="$2";    shift 2 ;;
      --cmd)        cmd="$2";     shift 2 ;;
      --claude)     claude="$2";  shift 2 ;;
      --repo)       repo="$2";    shift 2 ;;
      --desc)       desc="$2";    shift 2 ;;
      --managed-by) managed="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "usage: devkit register <name> --port N --cmd \"CMD\" [--path P]"
  assert_valid_name "$name"
  assert_valid_port "$port"

  acquire_lock
  migrate_legacy_registry

  if [[ "$managed" == "devkit" ]]; then
    # Default path to current directory — so you can register from inside the project
    [[ -z "$path" ]] && path="$PWD"
    [[ -n "$port" ]] || die "missing --port"
    [[ -n "$cmd"  ]] || die "missing --cmd"
    path="$(cd "$path" 2>/dev/null && pwd -P)" || die "path does not exist: $path"
  fi

  [[ -z "$claude" && -n "$path" ]] && claude=$(detect_claude_md "$path" || true)
  [[ -z "$repo" && -n "$path" ]] && repo=$(detect_repo "$path" || true)

  local hostname="$name.$(tld)"
  assert_unique "$name" "${port:-0}" "$hostname"

  ensure_registry
  local tmp; tmp=$(mktemp)
  jq --arg n "$name" --arg p "$path" --arg c "${claude:-}" \
     --arg cmd "${cmd:-}" --argjson port "${port:-0}" --arg h "$hostname" \
     --arg repo "${repo:-}" --arg desc "$desc" --arg m "$managed" \
    '.apps |= ((map(select(.name != $n))) + [{
       name: $n,
       hostname: $h,
       port: $port,
       path: (if $p == "" then null else $p end),
       repo: (if $repo == "" then null else $repo end),
       claudeMd: (if $c == "" then null else $c end),
       startCmd: (if $cmd == "" then null else $cmd end),
       description: $desc,
       managedBy: $m
     }])' "$APPS_JSON" > "$tmp"
  mv "$tmp" "$APPS_JSON"

  echo "registered $name → $(url_for "$hostname")"
  cmd_reload
}

cmd_rename() {
  local old="${1:-}" new="${2:-}"
  [[ -n "$old" && -n "$new" ]] || die "usage: devkit rename <old> <new>"
  acquire_lock
  migrate_legacy_registry

  assert_valid_name "$new"
  jq -e --arg n "$old" '.apps[] | select(.name==$n)' "$APPS_JSON" >/dev/null || die "unknown app: $old"
  if jq -e --arg n "$new" '.apps[] | select(.name==$n)' "$APPS_JSON" >/dev/null; then
    die "name already taken: $new"
  fi

  local was_running=false
  if is_running "$old"; then
    was_running=true
    local old_port old_path
    old_port=$(app_port "$old")
    old_path=$(app_path "$old")
    _stop_by_name "$old" "$old_port" "$old_path" || die "$old did not stop cleanly before rename"
  fi
  # Move PID/log files to new name
  [[ -f "$(pid_file "$old")" ]] && mv "$(pid_file "$old")" "$(pid_file "$new")" 2>/dev/null || true
  [[ -f "$(log_file "$old")" ]] && mv "$(log_file "$old")" "$(log_file "$new")" 2>/dev/null || true

  local new_host="$new.$(tld)"
  local tmp; tmp=$(mktemp)
  jq --arg old "$old" --arg new "$new" --arg h "$new_host" \
    '.apps |= map(if .name == $old then .name = $new | .hostname = $h else . end)' \
    "$APPS_JSON" > "$tmp"
  mv "$tmp" "$APPS_JSON"

  echo "renamed $old → $new (now at $(url_for "$new_host"))"
  cmd_reload

  if [[ "$was_running" == true ]]; then
    cmd_start "$new"
  fi
}

cmd_update() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit update <name> [--port N] [--cmd C] [--path P] [--desc D] [--managed-by M]"
  shift

  acquire_lock
  migrate_legacy_registry
  jq -e --arg n "$name" '.apps[] | select(.name==$n)' "$APPS_JSON" >/dev/null 2>&1 || die "unknown app: $name"

  local port="" cmd="" path="" desc="" managed=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)       port="$2";    shift 2 ;;
      --cmd)        cmd="$2";     shift 2 ;;
      --path)       path="$2";    shift 2 ;;
      --desc)       desc="$2";    shift 2 ;;
      --managed-by) managed="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  [[ -n "$port$cmd$path$desc$managed" ]] || die "nothing to update — specify at least one flag"
  assert_valid_port "$port"

  if [[ -n "$path" ]]; then
    path="$(cd "$path" 2>/dev/null && pwd -P)" || die "path does not exist: $path"
  fi

  # If running and the port is changing, stop first then restart after
  local was_running=false
  if [[ -n "$port" ]] && is_running "$name"; then
    was_running=true
    local old_port old_path
    old_port=$(app_port "$name")
    old_path=$(app_path "$name")
    _stop_by_name "$name" "$old_port" "$old_path" || die "$name did not stop cleanly"
  fi

  local tmp; tmp=$(mktemp)
  jq \
    --arg name    "$name" \
    --arg port    "$port" \
    --arg cmd     "$cmd" \
    --arg path    "$path" \
    --arg desc    "$desc" \
    --arg managed "$managed" \
    '.apps |= map(if .name != $name then . else . *
      (if $port    != "" then {port: ($port | tonumber)} else {} end) *
      (if $cmd     != "" then {startCmd: $cmd}           else {} end) *
      (if $path    != "" then {path: $path}              else {} end) *
      (if $desc    != "" then {description: $desc}       else {} end) *
      (if $managed != "" then {managedBy: $managed}      else {} end)
    end)' "$APPS_JSON" > "$tmp"
  mv "$tmp" "$APPS_JSON"

  echo "updated $name"
  cmd_reload

  if [[ "$was_running" == true ]]; then
    cmd_start "$name"
  fi
}

cmd_remove() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit remove <name>"
  acquire_lock
  migrate_legacy_registry
  if is_running "$name"; then
    local port path
    port=$(app_port "$name")
    path=$(app_path "$name")
    _stop_by_name "$name" "$port" "$path" || die "$name did not stop cleanly before remove"
  fi
  rm -f "$(pid_file "$name")" "$(log_file "$name")"
  local tmp; tmp=$(mktemp)
  jq --arg n "$name" '.apps |= map(select(.name != $n))' "$APPS_JSON" > "$tmp"
  mv "$tmp" "$APPS_JSON"
  echo "removed $name"
  cmd_reload
}

cmd_list() {
  ensure_registry
  printf "%-18s %-7s %-32s %-9s %s\n" NAME PORT URL STATE PATH
  while IFS=$'\t' read -r name port hostname path managed; do
    local state="stopped"
    [[ "$managed" == "pm2" ]] && managed="devkit"
    if [[ "$managed" == "devkit" ]]; then
      is_running "$name" && state="running" || state="stopped"
    elif [[ "$managed" == "external" ]]; then
      state="external"
    fi
    printf "%-18s %-7s %-32s %-9s %s\n" "$name" "$port" "$(url_for "$hostname")" "$state" "${path:-—}"
  done < <(jq -r '.apps[] | [.name, (.port|tostring), .hostname, (.path // ""), .managedBy] | @tsv' "$APPS_JSON")
}

cmd_show() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit show <name>"
  ensure_registry
  jq --arg n "$name" '.apps[] | select(.name==$n)' "$APPS_JSON"
}

# ---------- process management ----------

# Recursively kill a process and all its children (depth-first, SIGTERM then SIGKILL).
_kill_tree() {
  local pid=$1 sig=${2:-TERM}
  local children; children=$(pgrep -P "$pid" 2>/dev/null || true)
  for child in $children; do
    _kill_tree "$child" "$sig"
  done
  kill "-$sig" "$pid" 2>/dev/null || true
}

_stop_by_name() {
  local name="$1"
  local port="${2:-}"
  local path="${3:-}"
  local pf; pf=$(pid_file "$name")
  local logfile; logfile=$(log_file "$name")
  [[ -n "$port" ]] || port=$(app_port "$name")
  [[ -n "$path" ]] || path=$(app_path "$name")

  local pid=""
  if [[ -f "$pf" ]]; then
    pid=$(cat "$pf")
  fi

  local pid_is_app=false
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && pid_matches_app "$pid" "$port" "$path" "$logfile"; then
    pid_is_app=true
    {
      _kill_tree "$pid" TERM
      wait_for_pid_exit "$pid" 30 || true
      if kill -0 "$pid" 2>/dev/null; then
        _kill_tree "$pid" KILL 2>/dev/null || true
        wait_for_pid_exit "$pid" 20 || true
      fi
      wait "$pid" 2>/dev/null || true
    } 2>/dev/null
  fi

  local app_listeners=""
  if [[ -n "$port" && -n "$path" ]]; then
    app_listeners=$(listener_pids_for_app "$port" "$path" "$logfile")
  fi

  if [[ -n "$app_listeners" ]]; then
    local listener
    for listener in $app_listeners; do
      _kill_tree "$listener" TERM 2>/dev/null || true
    done
    wait_for_port_state "$port" free 30 || true

    app_listeners=$(listener_pids_for_app "$port" "$path" "$logfile")
    if [[ -n "$app_listeners" ]]; then
      for listener in $app_listeners; do
        _kill_tree "$listener" KILL 2>/dev/null || true
      done
      wait_for_port_state "$port" free 20 || true
    fi
  fi

  if [[ -f "$pf" ]]; then
    if [[ "$pid_is_app" == true && -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
    if [[ -n "$port" && -n "$path" && -n "$(listener_pids_for_app "$port" "$path" "$logfile")" ]]; then
      return 1
    fi
    rm -f "$pf"
  fi
}

cmd_start() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit start <name>"
  migrate_legacy_registry

  local managed
  managed=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .managedBy' "$APPS_JSON")
  [[ -n "$managed" ]] || die "unknown app: $name"
  [[ "$managed" == "devkit" ]] || die "$name is managed-by=$managed — devkit does not control its lifecycle"

  local path cmd port
  path=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .path' "$APPS_JSON")
  cmd=$(jq -r  --arg n "$name" '.apps[] | select(.name==$n) | .startCmd' "$APPS_JSON")
  port=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .port' "$APPS_JSON")

  if [[ -z "$path" || ! -d "$path" ]]; then
    echo "devkit: $name — path missing or not a directory: $path" >&2; return 1
  fi
  if [[ -z "$cmd" || "$cmd" == "null" ]]; then
    echo "devkit: $name — no startCmd registered" >&2; return 1
  fi

  local pf lf; pf=$(pid_file "$name"); lf=$(log_file "$name")
  local path_for_app="$path"

  # Stop any existing tracked process before starting a new one
  _stop_by_name "$name" "$port" "$path_for_app" || {
    echo "devkit: $name — failed to stop cleanly before restart" >&2
    return 1
  }
  if ! wait_for_port_state "$port" free 20; then
    echo "devkit: $name — port $port is still in use by another process" >&2
    return 1
  fi

  # Double-fork via Perl to detach from the calling shell's process group.
  # This prevents the parent shell from printing "Terminated" when we kill the process.
  # The wrapper bash writes its PID first; once the app binds its port we reconcile
  # the pidfile to the real listener PID so later status/stop calls target the server.
  #
  # The start command is run via a single `bash -c "$DEVKIT_CMD"` — exactly one shell
  # interpretation, the same as typing it in a terminal. We deliberately do NOT `eval`
  # it: a second round of expansion was a footgun with no benefit (and surprising when
  # the command contains quotes/$ values).
  ( cd "$path" && DEVKIT_CMD="$cmd" DEVKIT_PF="$pf" DEVKIT_LOG="$lf" \
    perl -e '
      use POSIX qw(setsid);
      fork() && exit(0);
      setsid();
      fork() && exit(0);
      open STDIN,  "<",  "/dev/null";
      open STDOUT, ">>", $ENV{DEVKIT_LOG} or die;
      open STDERR, ">&STDOUT";
      exec "/bin/bash", "-c", q(echo $$ > "$DEVKIT_PF"; exec /bin/bash -c "$DEVKIT_CMD");
    ' )

  local pid="" i=0
  while (( i < 20 )); do
    pid=$(cat "$pf" 2>/dev/null || echo "")
    [[ -n "$pid" ]] && break
    sleep 0.1
    (( i++ ))
  done

  if ! wait_for_port_state "$port" listening 60; then
    _stop_by_name "$name" "$port" "$path_for_app" >/dev/null 2>&1 || true
    echo "devkit: $name failed to bind port $port — check logs: devkit logs $name" >&2
    return 1
  fi

  local listener_pid
  listener_pid=$(listener_pids_on_port "$port" | head -n1 || true)
  if [[ -n "$listener_pid" ]]; then
    pid="$listener_pid"
    echo "$pid" > "$pf"
  elif [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pf"
    echo "devkit: $name started listening on $port, but no stable listener PID was found" >&2
    return 1
  fi

  echo "started $name (pid $pid) → $(url_for "$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .hostname' "$APPS_JSON")")"
}

cmd_stop() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit stop <name>"
  migrate_legacy_registry
  is_running "$name" || { echo "devkit: $name is not running"; return 0; }
  local port path
  port=$(app_port "$name")
  path=$(app_path "$name")
  _stop_by_name "$name" "$port" "$path" || die "$name did not stop cleanly"
  echo "stopped $name"
}

cmd_restart() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit restart <name>"
  cmd_stop "$name"
  cmd_start "$name"
}

cmd_logs() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit logs <name>"
  local lf; lf=$(log_file "$name")
  [[ -f "$lf" ]] || die "no logs yet for $name (has it been started?)"
  tail -f "$lf"
}

cmd_start_all() {
  migrate_legacy_registry
  local started=0 failed=0
  while IFS= read -r name; do
    if cmd_start "$name"; then
      (( started++ ))
    else
      (( failed++ )) || true
    fi
  done < <(jq -r '.apps[] | select(.managedBy=="devkit") | .name' "$APPS_JSON")
  local msg="started $started app(s)"
  (( failed > 0 )) && msg="$msg, $failed failed" || true
  echo "$msg"
}

cmd_stop_all() {
  migrate_legacy_registry
  local stopped=0 failed=0
  while IFS= read -r name; do
    if is_running "$name"; then
      local port path
      port=$(app_port "$name")
      path=$(app_path "$name")
      if _stop_by_name "$name" "$port" "$path"; then
        echo "stopped $name"
        (( stopped++ ))
      else
        echo "devkit: failed to stop $name" >&2
        (( failed++ )) || true
      fi
    fi
  done < <(jq -r '.apps[] | select(.managedBy=="devkit") | .name' "$APPS_JSON")
  local msg="stopped $stopped app(s)"
  (( failed > 0 )) && msg="$msg, $failed failed" || true
  echo "$msg"
}

cmd_restart_all() {
  migrate_legacy_registry
  while IFS= read -r name; do
    cmd_restart "$name" || true
  done < <(jq -r '.apps[] | select(.managedBy=="devkit") | .name' "$APPS_JSON")
}

# ---------- generation ----------

render_caddyfile() {
  ensure_registry
  local pp; pp=$(proxy_port)
  local listen=""
  [[ "$pp" != "80" ]] && listen=":$pp"

  # Render to a temp file in the same directory, then rename into place. Rename is
  # atomic on the same filesystem, so a concurrent `caddy reload` (or the menu bar app)
  # can never read a half-written Caddyfile — it sees either the old file or the new one.
  local tmp; tmp=$(mktemp "$CADDYFILE.XXXXXX" 2>/dev/null) || return 1
  {
    echo "# generated by devkit — edit apps.json instead"
    echo "{"
    echo "  auto_https off"
    echo "  admin localhost:2019"
    echo "}"
    echo
    echo "# dashboard — only dashboard.html is served; apps.json, logs and pids stay private"
    echo "http://$(dash_host).$(tld)$listen {"
    echo "  root * $DEVKIT_HOME"
    echo "  handle / {"
    echo "    rewrite * /dashboard.html"
    echo "    file_server"
    echo "  }"
    echo "  handle /dashboard.html {"
    echo "    file_server"
    echo "  }"
    echo "  handle {"
    echo "    respond \"not found\" 404"
    echo "  }"
    echo "}"
    echo
    jq -r --arg listen "$listen" '
      .apps[]
      | "http://\(.hostname)\($listen) {\n  reverse_proxy localhost:\(.port)\n}\n"
    ' "$APPS_JSON"
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$CADDYFILE"
}

render_dashboard() {
  ensure_registry

  local rows=""
  local link_attrs='target="_blank" rel="noopener"'
  while IFS=$'\t' read -r name hostname port managed path repo claude; do
    local url; url=$(url_for "$hostname")
    local repo_cell="—"
    [[ -n "$repo" && "$repo" != "null" ]] && repo_cell="<a href=\"$repo\" $link_attrs>repo</a>"
    local claude_cell="—"
    [[ -n "$claude" && "$claude" != "null" ]] && claude_cell="<a href=\"file://$claude\" $link_attrs>CLAUDE.md</a>"
    local path_cell="—"
    [[ -n "$path" && "$path" != "null" ]] && path_cell="$path"
    rows+="        <tr data-port=\"$port\" data-managed=\"$managed\">
          <td class=\"name\">$name</td>
          <td class=\"status\"><span class=\"dot dot-unknown\" title=\"checking…\"></span></td>
          <td><a href=\"$url\" $link_attrs>$hostname</a></td>
          <td class=\"port\">$port</td>
          <td class=\"managed\">$managed</td>
          <td class=\"path\">$path_cell</td>
          <td>$repo_cell</td>
          <td>$claude_cell</td>
          <td><code class=\"copy\" title=\"click to copy\">devkit edit $name</code></td>
        </tr>
"
  done < <(jq -r '.apps[] | [.name, .hostname, (.port|tostring), .managedBy, (.path // ""), (.repo // ""), (.claudeMd // "")] | @tsv' "$APPS_JSON")

  # Atomic write (temp-in-dir + rename), same rationale as render_caddyfile.
  local tmp; tmp=$(mktemp "$DASHBOARD.XXXXXX" 2>/dev/null) || return 1
  cat > "$tmp" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>devkit dashboard</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body { font: 14px/1.5 -apple-system, BlinkMacSystemFont, sans-serif; margin: 2rem auto; max-width: 1100px; padding: 0 1rem; color: #1a1a1a; background: #fafafa; }
  h1 { margin: 0 0 .25rem; font-size: 1.5rem; }
  p.lede { color: #666; margin: 0 0 1.5rem; }
  table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden; }
  th, td { padding: .65rem .9rem; text-align: left; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
  th { background: #f6f6f6; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #555; }
  tr:last-child td { border-bottom: none; }
  tr:hover { background: #fafbfc; }
  td.name { font-weight: 600; }
  td.port { font-variant-numeric: tabular-nums; color: #666; }
  td.managed { color: #888; font-size: 12px; }
  td.path { color: #666; font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
  a { color: #0066cc; text-decoration: none; }
  a:hover { text-decoration: underline; }
  code.copy { font-family: ui-monospace, Menlo, monospace; font-size: 12px; background: #f0f0f0; padding: 2px 6px; border-radius: 4px; cursor: pointer; user-select: all; }
  code.copy:hover { background: #e5e5e5; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; }
  .dot-unknown { background: #d1d5db; }
  .dot-up { background: #22c55e; }
  .dot-down { background: #ef4444; }
  .dot-ext { background: #a78bfa; }
  td.status { text-align: center; width: 3rem; }
  footer { margin-top: 1.5rem; color: #888; font-size: 12px; }
  @media (prefers-color-scheme: dark) {
    body { color: #e5e5e5; background: #111; }
    table { background: #1a1a1a; border-color: #2a2a2a; }
    th { background: #222; color: #aaa; }
    th, td { border-color: #2a2a2a; }
    tr:hover { background: #1f1f1f; }
    a { color: #6ab4ff; }
    code.copy { background: #2a2a2a; }
    code.copy:hover { background: #333; }
    p.lede, td.port, td.managed, td.path, footer { color: #999; }
  }
</style>
</head>
<body>
<h1>devkit dashboard</h1>
<p class="lede">All registered local apps. Click a hostname to open. Click the edit command to copy.</p>
<table>
  <thead><tr><th>Name</th><th>Status</th><th>URL</th><th>Port</th><th>Managed</th><th>Path</th><th>Repo</th><th>Claude</th><th>Edit</th></tr></thead>
  <tbody>
$rows
  </tbody>
</table>
<footer>Source: $APPS_JSON · Regenerate: <code>devkit reload</code></footer>
<script>
document.querySelectorAll('code.copy').forEach(c => {
  c.addEventListener('click', () => {
    navigator.clipboard.writeText(c.textContent.trim());
    const orig = c.textContent;
    c.textContent = 'copied!';
    setTimeout(() => c.textContent = orig, 800);
  });
});
function checkStatus() {
  document.querySelectorAll('tr[data-port]').forEach(row => {
    const port = row.dataset.port;
    const managed = row.dataset.managed;
    const dot = row.querySelector('.dot');
    if (managed === 'external') {
      dot.className = 'dot dot-ext';
      dot.title = 'external';
      return;
    }
    fetch('http://localhost:' + port, { mode: 'no-cors', cache: 'no-store' })
      .then(() => { dot.className = 'dot dot-up'; dot.title = 'up'; })
      .catch(() => { dot.className = 'dot dot-down'; dot.title = 'down'; });
  });
}
checkStatus();
setInterval(checkStatus, 15000);
</script>
</body>
</html>
HTML
  mv "$tmp" "$DASHBOARD"
}

# ---------- proxy lifecycle ----------

# Fingerprint of the registry's *normalized* content. Using the content (not the file
# mtime) is what makes staleness detection robust: restoring from a backup, syncing
# from another machine, or `git checkout` can all leave apps.json with an OLDER
# timestamp than the Caddyfile, so an mtime comparison would wrongly conclude "fresh"
# and the .localhost hosts would silently stop resolving. A content hash can't be
# fooled that way, and `jq -S -c` normalizes formatting so cosmetic re-saves don't churn.
registry_fingerprint() {
  jq -S -c . "$APPS_JSON" 2>/dev/null | _hash
}

stamp_fingerprint() {
  printf '%s\n' "$(registry_fingerprint)" > "$STAMP_FILE" 2>/dev/null || true
}

# True when the generated config no longer matches apps.json — either a generated file
# is missing, or the registry changed since we last rendered (including out-of-band edits).
registry_is_stale() {
  [[ -f "$CADDYFILE" && -f "$DASHBOARD" && -f "$STAMP_FILE" ]] || return 0
  local cur stored
  cur=$(registry_fingerprint)
  [[ -n "$cur" ]] || return 1            # unreadable/invalid registry → don't churn
  stored=$(cat "$STAMP_FILE" 2>/dev/null || echo "")
  [[ "$cur" != "$stored" ]]
}

# Self-healing reconcile, run at the top of every routing-dependent command. If
# apps.json was changed outside devkit, regenerate the Caddyfile + dashboard and reload
# Caddy so hostnames resolve again — no matter which command the user happened to run.
# Strictly best-effort: it must never fail a read-only command (e.g. `list` on a
# read-only registry dir), so every step is guarded.
ensure_fresh() {
  ensure_registry
  registry_is_stale || return 0
  render_caddyfile 2>/dev/null || return 0
  render_dashboard 2>/dev/null || return 0
  stamp_fingerprint
  caddy_admin_reload >/dev/null 2>&1 || true
  return 0
}

# Returns: 0 = actually reloaded, 1 = caddy not installed,
#          2 = caddy installed but not managing devkit's Caddyfile (not symlinked).
caddy_admin_reload() {
  command -v caddy >/dev/null 2>&1 || return 1
  # Ownership check: only push config to Caddy if it's actually serving devkit's file,
  # so we never clobber a Caddy the user runs for something else. The Homebrew symlink is
  # the normal signal; DEVKIT_CADDY_MANAGED=1 is the escape hatch for source/manual setups
  # that run `caddy run --config ~/.devkit/Caddyfile` directly (no brew symlink).
  if [[ "${DEVKIT_CADDY_MANAGED:-0}" != "1" ]]; then
    local linked; linked=$(readlink "$BREW_CADDYFILE" 2>/dev/null || true)
    [[ "$linked" == "$CADDYFILE" ]] || return 2
  fi
  caddy reload --config "$CADDYFILE" --address "${DEVKIT_CADDY_ADMIN:-localhost:2019}"
}

cmd_reload() {
  render_caddyfile
  render_dashboard
  stamp_fingerprint
  # Capture exit code without tripping `set -e` on a non-zero reload.
  local out code
  if out=$(caddy_admin_reload 2>&1); then code=0; else code=$?; fi
  case "$code" in
    0)
      echo "reloaded Caddy"
      ;;
    2)
      # Be honest: the route was written but Caddy is NOT serving it yet, so the new
      # app's URL would 404. Don't claim success.
      echo "devkit: registry updated, but Caddy isn't using devkit's config yet — your" >&2
      echo "  new URL won't resolve until you link it. Run: devkit bootstrap" >&2
      echo "  then: sudo brew services start caddy" >&2
      ;;
    *)
      # Registry + Caddyfile are written correctly; Caddy just isn't running/installed.
      echo "devkit: warning — Caddy not reloaded (is it installed and running?)" >&2
      echo "  Run: sudo brew services start caddy" >&2
      [[ -n "$out" ]] && echo "  $out" >&2
      ;;
  esac
  return 0
}

cmd_bootstrap() {
  echo "checking caddy..."
  if ! command -v caddy >/dev/null 2>&1; then
    command -v brew >/dev/null 2>&1 || die "homebrew required"
    echo "installing caddy..."
    brew install caddy
  fi

  render_caddyfile
  render_dashboard
  stamp_fingerprint

  if [[ -e "$BREW_CADDYFILE" && ! -L "$BREW_CADDYFILE" ]]; then
    echo "$BREW_CADDYFILE exists and is not a symlink — leaving it alone"
  elif [[ ! -L "$BREW_CADDYFILE" ]]; then
    echo "symlinking $BREW_CADDYFILE -> $CADDYFILE"
    ln -sfn "$CADDYFILE" "$BREW_CADDYFILE"
  fi

  echo
  echo "next steps (one-time):"
  echo "  sudo brew services start caddy"
  echo
  echo "then visit: $(url_for "$(dash_host).$(tld)")"
}

# ---------- editor / browser ----------

cmd_open() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit open <name>"
  ensure_registry
  local host
  host=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .hostname' "$APPS_JSON")
  [[ -n "$host" ]] || die "unknown app: $name"
  open "$(url_for "$host")"
}

cmd_edit() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit edit <name>"
  ensure_registry
  local path
  path=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .path // ""' "$APPS_JSON")
  [[ -n "$path" ]] || die "$name has no path"
  [[ -d "$path" ]] || die "path missing: $path (run: devkit clone $name)"
  cd "$path"
  if command -v claude >/dev/null 2>&1; then
    exec claude
  else
    echo "cd $path"
    echo "claude not found in PATH — opening shell"
    exec "${SHELL:-/bin/zsh}"
  fi
}

cmd_clone() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: devkit clone <name>"
  ensure_registry
  local path repo
  path=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .path // ""' "$APPS_JSON")
  repo=$(jq -r --arg n "$name" '.apps[] | select(.name==$n) | .repo // ""' "$APPS_JSON")
  [[ -n "$repo" ]] || die "$name has no repo URL — set one with devkit register --name $name --repo <url> ..."
  [[ -n "$path" ]] || die "$name has no path"
  if [[ -d "$path/.git" ]]; then
    echo "$name already cloned at $path"
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  git clone "$repo" "$path"
}

cmd_clone_all() {
  ensure_registry
  jq -r '.apps[] | select(.repo != null and .path != null) | .name' "$APPS_JSON" |
    while read -r n; do cmd_clone "$n" || true; done
}

cmd_paths() {
  ensure_registry   # run any pending one-time migration so the paths reflect reality
  cat <<OUT
REPO_HOME=$REPO_HOME
DEVKIT_HOME=$DEVKIT_HOME
APPS_JSON=$APPS_JSON
CADDYFILE=$CADDYFILE
DASHBOARD=$DASHBOARD
PIDS_DIR=$PIDS_DIR
LOGS_DIR=$LOGS_DIR
STAMP_FILE=$STAMP_FILE
OUT
}

# ---------- MCP integration ----------

# Wire the devkit MCP server into an AI agent so it can register/manage apps as
# structured tool calls (instead of relying on a CLAUDE.md text instruction).
cmd_setup_mcp() {
  local candidates=(
    "$REPO_HOME/../devkit-mcp/index.js"
    "$REPO_HOME/devkit-mcp/index.js"
    "$REPO_HOME/mcp-server/index.js"
    "$DEVKIT_HOME/devkit-mcp/index.js"
    "$DEVKIT_HOME/mcp-server/index.js"
    "$HOME/devkit/mcp-server/index.js"
  )
  local server="" c
  for c in "${candidates[@]}"; do
    if [[ -f "$c" ]]; then
      server="$(cd "$(dirname "$c")" && pwd)/index.js"
      break
    fi
  done
  [[ -n "$server" ]] || die "could not find the devkit MCP server (index.js) — expected near $REPO_HOME/../devkit-mcp/"

  need node

  # Install the MCP's dependencies if missing, otherwise the server crashes on first
  # call with "Cannot find module @modelcontextprotocol/sdk".
  local server_dir; server_dir=$(dirname "$server")
  if [[ ! -d "$server_dir/node_modules/@modelcontextprotocol" ]]; then
    need npm
    echo "installing devkit MCP dependencies..."
    (cd "$server_dir" && npm install --silent) || die "npm install failed in $server_dir"
  fi

  if command -v claude >/dev/null 2>&1; then
    if claude mcp add devkit -- node "$server"; then
      echo "devkit MCP registered with Claude Code. Restart Claude Code to load it."
    else
      die "failed to register the MCP with Claude Code (try: claude mcp add devkit -- node \"$server\")"
    fi
  else
    echo "Claude Code CLI not found. Add the devkit MCP to your agent manually:"
    echo "  command: node"
    echo "  args:    $server"
    echo
    echo "  Claude Code:  claude mcp add devkit -- node \"$server\""
    echo "  Cursor/Codex: add the same command+args to the editor's MCP config."
  fi
}

# ---------- help ----------

cmd_help() {
  cat <<'OUT'
devkit — local app registry, hostname proxy, process manager, dashboard

Registry:
  devkit register <name> --port N --cmd "C" [--path P] [--repo URL] [--desc "..."]
                              [--managed-by devkit|external]
  devkit rename <old> <new>
  devkit update <name> [--port N] [--cmd C] [--path P] [--desc D] [--managed-by M]
  devkit remove <name>
  devkit list
  devkit show <name>

Process:
  devkit start <name>
  devkit stop <name>
  devkit restart <name>
  devkit logs <name>
  devkit start-all | stop-all | restart-all

Browser / editor:
  devkit open <name>
  devkit edit <name>

Sync / portability:
  devkit clone <name>
  devkit clone-all
  devkit bootstrap
  devkit paths

AI agent integration:
  devkit setup-mcp          # register the devkit MCP server with Claude Code / your agent

Internals:
  devkit reload
  devkit version
OUT
}

cmd_version() { echo "devkit $DEVKIT_VERSION"; }

# Self-heal stale routing before any command that depends on the proxy being correct.
# Mutating commands (register/rename/update/remove) re-render at the end via cmd_reload,
# so they don't need this — but every read/lifecycle path does, which is what closes the
# "apps.json edited outside devkit" gap regardless of which command the user runs.
case "${1:-help}" in
  start|stop|restart|start-all|stop-all|restart-all|list|show|open|logs|clone|clone-all|edit)
    ensure_fresh
    ;;
esac

case "${1:-help}" in
  register)    shift; cmd_register "$@" ;;
  rename)      shift; cmd_rename "$@" ;;
  update)      shift; cmd_update "$@" ;;
  remove)      shift; cmd_remove "$@" ;;
  list)        cmd_list ;;
  show)        shift; cmd_show "$@" ;;
  reload)      cmd_reload ;;
  bootstrap)   cmd_bootstrap ;;
  start)       shift; cmd_start "$@" ;;
  stop)        shift; cmd_stop "$@" ;;
  restart)     shift; cmd_restart "$@" ;;
  start-all)   cmd_start_all ;;
  stop-all)    cmd_stop_all ;;
  restart-all) cmd_restart_all ;;
  logs)        shift; cmd_logs "$@" ;;
  open)        shift; cmd_open "$@" ;;
  edit)        shift; cmd_edit "$@" ;;
  clone)       shift; cmd_clone "$@" ;;
  clone-all)   cmd_clone_all ;;
  paths)       cmd_paths ;;
  setup-mcp)   cmd_setup_mcp ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h) cmd_help ;;
  *) echo "devkit: unknown command: $1" >&2; cmd_help; exit 2 ;;
esac
